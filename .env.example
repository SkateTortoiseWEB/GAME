# Supabase (server-side only; leave unset to run with an in-memory store)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM judge for answers that miss the curated list.
# Any OpenAI-compatible chat completions endpoint works
# (OpenAI, Gemini's OpenAI-compat endpoint, DeepSeek, ...). Unset = no LLM fallback.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-nano
