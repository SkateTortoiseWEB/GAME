# Supabase (server-side only; leave unset to run with an in-memory store)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM judge for answers that miss the curated list.
# Any OpenAI-compatible chat completions endpoint works
# (OpenAI, Gemini's OpenAI-compat endpoint, DeepSeek, ...). Unset = no LLM fallback.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-nano

# Optional. How hard a reasoning model thinks before answering (e.g. minimal / low / none). Lower = faster.
# Defaults to "minimal" for gpt-5 / o-series models and is not sent otherwise.
LLM_REASONING_EFFORT=
# Optional. Give up on the LLM after this many ms (default 6000, per attempt; one automatic retry on timeouts and 5xx errors).
LLM_TIMEOUT_MS=

# Optional. Where the no-database dev mode saves checked answers (default .data/verdicts.json).
VERDICT_FILE=
